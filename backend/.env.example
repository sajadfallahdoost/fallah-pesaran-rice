# Environment for the backend. Load with docker compose env_file, or locally: set -a; . ./.env; set +a
# Never commit .env. Values here are development placeholders only.
STORE_ENV=development              # development | test | production
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=                  # required in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
DATABASE_URL=postgres://fallah:fallah_dev_pw@127.0.0.1:55432/fallah
PUBLIC_BASE_URL=http://localhost:3010

# Storefront cache revalidation (Next.js /api/revalidate). Same secret in frontend env.
STOREFRONT_REVALIDATE_URL=http://127.0.0.1:3010/api/revalidate
STOREFRONT_REVALIDATE_SECRET=

# Sales
STORE_ALLOW_SAMPLE_SALES=true       # must be false in production (default there)
ORDER_RESERVATION_MINUTES=30

# Payments: development simulator. Refused when STORE_ENV=production.
PAYMENT_MOCK_ENABLED=true
# Real gateways: a provider becomes selectable only when its credentials exist here AND it is enabled in admin.
ZARINPAL_MERCHANT_CODE=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT_CODE=
SEP_MERCHANT_CODE=
SEP_TERMINAL_CODE=
MELLAT_TERMINAL_CODE=
MELLAT_USERNAME=
MELLAT_PASSWORD=
BMI_MERCHANT_CODE=
BMI_TERMINAL_CODE=
BMI_SECRET_KEY=

# SMS login codes. console prints codes to the server log (development only; refused in production).
SMS_BACKEND=console                 # console | kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
