# Copy to .env.production (never commit it) and fill every empty value.
# Used both for compose variable substitution (--env-file) and as the backend's env_file.

# Public origin customers use, with https. Payment callbacks and receipt links are built from it.
PUBLIC_BASE_URL=https://example.ir
# Public hostnames, plus "backend" (the storefront server calls Django by container name).
DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
DJANGO_SECRET_KEY=
# Proxies in front of Django: nginx (1) + your TLS proxy (1).
DJANGO_NUM_PROXIES=2
DJANGO_HSTS_SECONDS=0

HTTP_PORT=8090

POSTGRES_USER=fallah
POSTGRES_DB=fallah
POSTGRES_PASSWORD=

# At least 16 random characters; shared by Django and the storefront.
STOREFRONT_REVALIDATE_SECRET=

ORDER_RESERVATION_MINUTES=30
LOG_LEVEL=INFO

# SMS login codes (production requires a real provider).
SMS_BACKEND=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Payment providers: a provider is offered only when its credentials are set here AND it is
# enabled in the admin (Payments › Payment providers). Leave unused providers empty.
PAYMENT_DEFAULT_PROVIDER=ZARINPAL
ZARINPAL_MERCHANT_CODE=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT_CODE=
SEP_MERCHANT_CODE=
SEP_TERMINAL_CODE=
MELLAT_TERMINAL_CODE=
MELLAT_USERNAME=
MELLAT_PASSWORD=
BMI_MERCHANT_CODE=
BMI_TERMINAL_CODE=
BMI_SECRET_KEY=
